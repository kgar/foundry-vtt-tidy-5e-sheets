    "TIDY5E.SETTINGS": {
        "Menu": {
            "HeaderControls": {
                "hint": "仅新 Tidy 表单：配置表单标题控制器位置。",
                "name": "标题控制器"
            },
            "Tabs": {
                "hint": "仅限 Tidy 表单：配置所有角色和物品卡中可见的标签卡。",
                "name": "表单选项卡"
            }
        },
        "Option": {
            "ActionList": {
                "IncludeConsumables": {
                    "hint": "默认情况下，将具有激活消耗（动作、附赠动作等）的消耗品列入“动作”列表。",
                    "name": "将消耗品视为动作"
                },
                "IncludeMinuteLongSpells": {
                    "hint": "默认情况下，在“动作”选项卡/面板中包含持续时间在一分钟或更短（例如 1 轮）且激活时间为 1 动作或 1 附赠动作（例如“祝福术”“灾祸术”“命令术”）的法术。",
                    "name": "将持续一分钟的法术视为动作"
                },
                "IncludeSpellsWithActiveEffects": {
                    "hint": "默认情况下，在“动作”选项卡/面板中包含带有持续效果的法术（例如“树肤术”）。",
                    "name": "将具有持续效果的法术视为动作"
                },
                "LimitToCantrips": {
                    "hint": "默认情况下，在\"动作\"选项卡/面板中不再显示所有造成伤害的法术，而是仅限戏法。此设定与 D&DBeyond 平台的默认行为保持一致。",
                    "name": "将动作限制为戏法"
                }
            },
            "Inspiration": {
                "Banked": {
                    "Enable": {
                        "hint": "启用此选项可允许用户将具有用途的特性物品设置为激励来源。在具有用途的特性物品上查找此选项，它会作为上下文菜单项出现。",
                        "name": "启用激励储蓄"
                    },
                    "GmOnly": {
                        "hint": "启用此选项可将激励储蓄管理权限限制为GM。",
                        "name": "激励储蓄管理 - 仅GM"
                    },
                    "Title": "激励储蓄"
                }
            },
            "Interaction": {
                "ContextMenu": {
                    "hint": "启用物品上的右键单击上下文菜单。",
                    "name": "使用上下文菜单"
                }
            },
            "Item": {
                "IdentificationPermission": {
                    "hint": "确定能够有权进行鉴定物品的 UI 控件的用户类型。",
                    "name": "物品鉴定权限",
                    "option": {
                        "GmAndOwners": "GM 和物品拥有者",
                        "GmOnly": "仅 GM"
                    }
                }
            },
            "Security": {
                "GroupSheetMembers": {
                    "hint": "允许 DM 控制用户在小队卡上可以看到的小队成员信息。当玩家对小队成员没有权限时，小队卡不会显示该成员或其信息。具有有限权限时，用户可以看到成员的名称，但看不到其他信息。具有观察员或更高权限时，用户可以看到关于该成员的小队卡上的所有信息。",
                    "name": "使用小队卡成员权限设置"
                }
            },
            "Sheet": {
                "DefaultDeathSaveRoll": {
                    "hint": "确定进行死亡豁免掷骰时所使用的默认骰子类型。",
                    "name": "默认死亡豁免掷骰"
                },
                "DefaultTabs": {
                    "hint": "确定默认情况下哪些选项卡会显示以及显示的顺序。当尚未为某个角色选择选项卡时生效。",
                    "name": "默认工作卡选项卡"
                },
                "InlineActivitiesPosition": {
                    "hint": "展开某一物品时，会显示该物品的行动。使用此设置来确定行动是置于顶部（在物品描述之前），还是置于底部（在物品描述、按钮和标签之后）。",
                    "name": "内联行动位置",
                    "option": {
                        "bottom": "底部",
                        "top": "顶部"
                    }
                }
            },
            "Spells": {
                "IncludeFlagsInScrollCreation": {
                    "hint": "法术有时会包含来自其他模块的特殊数据，这些数据在制作法术卷轴时可能会很有用。启用此选项后，在创建法术卷轴时将复制所有基于标记的数据。",
